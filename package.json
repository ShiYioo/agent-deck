{
  "name": "agent-deck",
  "private": true,
  "version": "0.1.1",
  "description": "一个桌面指挥台：用统一的界面驱动 zcode / codex 等无头编码 agent",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "bundle:sidecar": "node agent/build.mjs",
    "preview": "vite preview",
    "test:ui": "playwright test",
    "bench:ui": "node scripts/benchmark-ui.mjs",
    "test:runtime": "node --test agent/runtime.test.mjs agent/native-harness.test.mjs agent/workflow-plan.test.mjs",
    "runnerctl": "node scripts/runnerctl.mjs",
    "test:control": "node --test scripts/runnerctl.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "lucide-react": "^1.54.0",
    "motion": "^14.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
